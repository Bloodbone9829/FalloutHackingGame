<Window x:Class="HackingGameUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HackingGameUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Background="Black" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
            <TextBlock Text="ROBCO INDUSTRIES (TM) TERMLINK" 
                       Foreground="#00FF00" 
                       FontSize="18" 
                       FontFamily="Consolas" 
                       FontWeight="Bold" 
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="ATTEMPTS LEFT: " 
                           Foreground="#00FF00" 
                           FontFamily="Consolas" 
                           FontSize="18"/>
                <TextBlock x:Name="TxtAttempts" 
                           Text="4" 
                           Foreground="#00FF00" 
                           FontFamily="Consolas" 
                           FontSize="18" 
                           FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#004400" BorderThickness="2" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtHexLeft" Grid.Column="0"
                       Foreground="#008800" FontFamily="Consolas" FontSize="20"
                       LineHeight="24" TextAlignment="Right" IsHitTestVisible="False"/>

                    <TextBox x:Name="TxtBoardLeft" Grid.Column="2"
                            Foreground="#00FF00" Background="Transparent" BorderThickness="0"
                            FontFamily="Consolas" FontSize="20" TextBlock.LineHeight="24"
                            TextWrapping="NoWrap" IsReadOnly="True" Cursor="Hand"
                            Focusable="True" 
                            SelectionOpacity="1.0" 
                            SelectionBrush="#00FF00"
                            SelectionTextBrush="Black"
                            IsReadOnlyCaretVisible="False"
                            PreviewMouseLeftButtonDown="TxtBoard_Click"
                            MouseMove="TxtBoard_MouseMove"
                            MouseLeave="TxtBoard_MouseLeave"/>

                    <TextBlock x:Name="TxtHexRight" Grid.Column="4"
                       Foreground="#008800" FontFamily="Consolas" FontSize="20"
                       LineHeight="24" TextAlignment="Right" IsHitTestVisible="False"/>

                    <TextBox x:Name="TxtBoardRight" Grid.Column="6"                             
                            Foreground="#00FF00" Background="Transparent" BorderThickness="0"
                            FontFamily="Consolas" FontSize="20" TextBlock.LineHeight="24"
                            TextWrapping="NoWrap" IsReadOnly="True" Cursor="Hand"
                            Focusable="True" 
                            SelectionOpacity="1.0" 
                            SelectionBrush="#00FF00"
                            SelectionTextBrush="Black"
                            IsReadOnlyCaretVisible="False"
                            PreviewMouseLeftButtonDown="TxtBoard_Click"
                            MouseMove="TxtBoard_MouseMove"
                            MouseLeave="TxtBoard_MouseLeave"/>   
                </Grid>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="TxtStatus" 
                   Grid.Row="2"
                   Text="> WELCOME USER..." 
                   Foreground="#00FF00" 
                   FontFamily="Consolas" 
                   FontSize="16" 
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
